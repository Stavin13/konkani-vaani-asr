 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Marathi ASR Training on Kaggle\n",
    "\n",
    "## 📋 Setup Instructions\n",
    "\n",
    "### Before Running:\n",
    "1. **Enable GPU**: Settings → Accelerator → GPU T4 x2\n",
    "2. **Enable Internet**: Settings → Internet → ON\n",
    "3. **Add Dataset**: Add Data → Your Datasets → \"Marathi ASR Training Complete\"\n",
    "\n",
    "### Expected Results:\n",
    "- Training time: 2-3 hours for 50 epochs\n",
    "- Target WER: <12% (down from 16.58%)\n",
    "- Improvement: ~40% better\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 1: Extract Package"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 1: Setup - Use files directly from input (NO COPYING)\n",
    "import os\n",
    "import sys\n",
    "\n",
    "print(\"Setting up paths...\\n\")\n",
    "\n",
    "# Find where files are in the input directory\n",
    "input_base = \"/kaggle/input/marathi-asr-training-complete\"\n",
    "possible_dirs = [\n",
    "    os.path.join(input_base, \"kaggle_training_complete\"),\n",
    "    input_base\n",
    "]\n",
    "\n",
    "# Find the source directory\n",
    "DATA_DIR = None\n",
    "for d in possible_dirs:\n",
    "    if os.path.exists(os.path.join(d, \"marathi_asr\")):\n",
    "        DATA_DIR = d\n",
    "        break\n",
    "\n",
    "if not DATA_DIR:\n",
    "    print(\"⚠️ Could not find marathi_asr directory!\")\n",
    "    print(\"\\nChecking what's available:\")\n",
    "    !ls -la /kaggle/input/marathi-asr-training-complete/\n",
    "    raise FileNotFoundError(\"marathi_asr directory not found\")\n",
    "\n",
    "print(f\"✓ Data directory: {DATA_DIR}\")\n",
    "\n",
    "# Add code to Python path (no copying needed!)\n",
    "sys.path.insert(0, os.path.join(DATA_DIR, 'marathi_asr'))\n",
    "sys.path.insert(0, DATA_DIR)\n",
    "\n",
    "print(f\"✓ Added to Python path\")\n",
    "print(f\"\\n💡 Using files directly from input (saves disk space!)\")\n",
    "print(f\"\\nAvailable directories:\")\n",
    "for item in ['marathi_asr', 'kaggle_model_output', 'synthetic_audio']:\n",
    "    path = os.path.join(DATA_DIR, item)\n",
    "    if os.path.exists(path):\n",
    "        print(f\"  ✓ {item}\")\n",
    "    else:\n",
    "        print(f\"  ✗ {item} NOT FOUND\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 2: Install Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 2: Install dependencies\n",
    "!pip install -q librosa soundfile sentencepiece pyyaml jiwer\n",
    "\n",
    "print(\"✓ Dependencies installed!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 3: Verify GPU Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 3: Verify GPU\n",
    "import torch\n",
    "import sys\n",
    "\n",
    "print(f\"PyTorch: {torch.__version__}\")\n",
    "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"GPU Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB\")\n",
    "else:\n",
    "    print(\"⚠️ NO GPU! Go to Settings and enable GPU T4 x2\")\n",
    "\n",
    "# Path already added in Cell 1\n",
    "print(\"\\n✓ Setup complete!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 4: Import Modules"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 4: Import modules\n",
    "from marathi_asr.config import ASRConfig\n",
    "from marathi_asr.models import MarathiASRModel\n",
    "from marathi_asr.models.encoder import TransformerEncoder\n",
    "from marathi_asr.models.decoder import TransformerDecoder\n",
    "from marathi_asr.data import MarathiASRDataset\n",
    "from marathi_asr.data.tokenizer import MarathiTokenizer\n",
    "from marathi_asr.data.feature_extractor import FeatureExtractor\n",
    "from marathi_asr.training import Trainer\n",
    "from torch.utils.data import DataLoader\n",
    "import time\n",
    "\n",
    "print(\"✓ All modules imported!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 5: Configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 5: Configuration\n",
    "config = ASRConfig(\n",
    "    encoder_layers=6,\n",
    "    decoder_layers=4,\n",
    "    model_dim=384,\n",
    "    num_heads=6,\n",
    "    ff_dim=1536,\n",
    "    dropout=0.1,\n",
    "    sample_rate=16000,\n",
    "    n_mels=80,\n",
    "    win_length_ms=25.0,\n",
    "    hop_length_ms=10.0,\n",
    "    normalize_features=True,\n",
    "    vocab_size=1000,\n",
    "    batch_size=32,\n",
    "    learning_rate=0.0001,\n",
    "    num_epochs=50,\n",
    "    checkpoint_interval=5,\n",
    "    use_fp16=True,\n",
    "    device=\"cuda\"\n",
    ")\n",
    "\n",
    "print(\"✓ Configuration loaded\")\n",
    "print(f\"  Epochs: {config.num_epochs}\")\n",
    "print(f\"  Batch size: {config.batch_size}\")\n",
    "print(f\"  Device: {config.device}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 5.5: Verify File Locations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 5.5: FIND TOKENIZER FILES\n",
    "import os\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"SEARCHING FOR TOKENIZER FILES\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Search entire input directory\n",
    "print(\"\\n1. Searching entire input directory for tokenizer:\")\n",
    "!find /kaggle/input -name \"*tokenizer.model\" -o -name \"*tokenizer.vocab\" 2>/dev/null\n",
    "\n",
    "# Check specific paths\n",
    "print(\"\\n2. Checking specific paths:\")\n",
    "tokenizer_paths = [\n",
    "    '/kaggle/input/marathi-asr-training-complete/marathi_tokenizer',\n",
    "    '/kaggle/input/marathi-asr-training-complete/kaggle_training_complete/marathi_tokenizer',\n",
    "    '/kaggle/input/marathi-asr-training-complete/kaggle_training_complete/kaggle_model_output/marathi_tokenizer',\n",
    "    os.path.join(DATA_DIR, 'marathi_tokenizer'),\n",
    "    os.path.join(DATA_DIR, 'kaggle_model_output', 'marathi_tokenizer')\n",
    "]\n",
    "\n",
    "for base_path in tokenizer_paths:\n",
    "    model_exists = os.path.exists(base_path + '.model')\n",
    "    vocab_exists = os.path.exists(base_path + '.vocab')\n",
    "    if model_exists and vocab_exists:\n",
    "        print(f\"✓✓ FOUND BOTH: {base_path}\")\n",
    "    elif model_exists:\n",
    "        print(f\"✓✗ Model only: {base_path}.model\")\n",
    "    elif vocab_exists:\n",
    "        print(f\"✗✓ Vocab only: {base_path}.vocab\")\n",
    "    else:\n",
    "        print(f\"✗✗ Not found: {base_path}\")\n",
    "\n",
    "# Show what's in DATA_DIR\n",
    "print(f\"\\n3. Contents of DATA_DIR ({DATA_DIR}):\")\n",
    "!ls -la {DATA_DIR} | head -20\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 6: Load or Create Tokenizer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 6: Load or create tokenizer\n",
    "print(\"Setting up tokenizer...\")\n",
    "tokenizer = MarathiTokenizer(vocab_size=config.vocab_size)\n",
    "\n",
    "# Try different possible paths - ROOT FIRST (where files actually are!)\n",
    "tokenizer_paths = [\n",
    "    '/kaggle/input/marathi-asr-training-complete/marathi_tokenizer',  # ROOT - files are here!\n",
    "    '/kaggle/input/tokenizer-marathi/marathi_tokenizer',  # Alternative dataset\n",
    "    os.path.join(DATA_DIR, 'kaggle_model_output', 'marathi_tokenizer'),\n",
    "    os.path.join(DATA_DIR, 'marathi_tokenizer'),\n",
    "    '/kaggle/working/marathi_tokenizer'  # Fallback if we create it\n",
    "]\n",
    "\n",
    "tokenizer_loaded = False\n",
    "print(\"Searching for tokenizer...\")\n",
    "for path in tokenizer_paths:\n",
    "    if os.path.exists(path + '.model'):\n",
    "        tokenizer.load(path)\n",
    "        print(f\"✓ Tokenizer loaded from {path}\")\n",
    "        tokenizer_loaded = True\n",
    "        break\n",
    "\n",
    "if not tokenizer_loaded:\n",
    "    print(\"\\n⚠️ Tokenizer files not found in dataset!\")\n",
    "    print(\"Creating new tokenizer from manifest files...\\n\")\n",
    "    \n",
    "    # Find manifest files\n",
    "    import pandas as pd\n",
    "    manifest_paths = [\n",
    "        os.path.join(DATA_DIR, 'synthetic_audio', 'train_manifest.csv')\n",
    "    ]\n",
    "    \n",
    "    manifest_path = None\n",
    "    for path in manifest_paths:\n",
    "        if os.path.exists(path):\n",
    "            manifest_path = path\n",
    "            break\n",
    "    \n",
    "    if not manifest_path:\n",
    "        raise FileNotFoundError(\"Cannot find manifest file to train tokenizer!\")\n",
    "    \n",
    "    # Read texts from manifest\n",
    "    df = pd.read_csv(manifest_path)\n",
    "    print(f\"Manifest columns: {df.columns.tolist()}\")\n",
    "    print(f\"First row: {df.iloc[0].to_dict()}\")\n",
    "    \n",
    "    # Try different possible column names\n",
    "    text_col = None\n",
    "    for col in ['text', 'transcript', 'transcription', 'label', 'sentence']:\n",
    "        if col in df.columns:\n",
    "            text_col = col\n",
    "            break\n",
    "    \n",
    "    if not text_col:\n",
    "        raise ValueError(f\"Could not find text column. Available columns: {df.columns.tolist()}\")\n",
    "    \n",
    "    texts = df[text_col].tolist()\n",
    "    print(f\"Training tokenizer on {len(texts)} samples from column '{text_col}'...\")\n",
    "    \n",
    "    # Train tokenizer\n",
    "    tokenizer.train(texts)\n",
    "    \n",
    "    # Save it\n",
    "    save_path = '/kaggle/working/marathi_tokenizer'\n",
    "    tokenizer.save(save_path)\n",
    "    print(f\"✓ Tokenizer trained and saved to {save_path}\")\n",
    "\n",
    "print(f\"✓ Tokenizer ready (vocab: {tokenizer.vocab_size})\")\n",
    "\n",
    "print(\"\\nCreating model...\")\n",
    "encoder = TransformerEncoder(\n",
    "    input_dim=config.n_mels,\n",
    "    model_dim=config.model_dim,\n",
    "    num_layers=config.encoder_layers,\n",
    "    num_heads=config.num_heads,\n",
    "    ff_dim=config.ff_dim,\n",
    "    dropout=config.dropout\n",
    ")\n",
    "\n",
    "decoder = TransformerDecoder(\n",
    "    vocab_size=tokenizer.vocab_size,\n",
    "    model_dim=config.model_dim,\n",
    "    num_layers=config.decoder_layers,\n",
    "    num_heads=config.num_heads,\n",
    "    ff_dim=config.ff_dim,\n",
    "    dropout=config.dropout\n",
    ")\n",
    "\n",
    "model = MarathiASRModel(encoder=encoder, decoder=decoder, tokenizer=tokenizer)\n",
    "\n",
    "print(\"\\nLoading trained weights...\")\n",
    "# Try different possible paths for the model using DATA_DIR\n",
    "model_paths = [\n",
    "    os.path.join(DATA_DIR, 'kaggle_model_output', 'best_model_wer.pt'),\n",
    "    os.path.join(DATA_DIR, 'best_model_wer.pt')\n",
    "]\n",
    "\n",
    "checkpoint = None\n",
    "for path in model_paths:\n",
    "    if os.path.exists(path):\n",
    "        checkpoint = torch.load(path, map_location='cpu')\n",
    "        print(f\"✓ Loaded checkpoint from {path}\")\n",
    "        break\n",
    "\n",
    "if checkpoint is None:\n",
    "    raise FileNotFoundError(\"Could not find model checkpoint in any expected location\")\n",
    "\n",
    "model.load_state_dict(checkpoint['model_state_dict'])\n",
    "\n",
    "current_epoch = checkpoint.get('epoch', 0)\n",
    "best_wer = checkpoint.get('best_wer', float('inf'))\n",
    "best_loss = checkpoint.get('best_loss', float('inf'))\n",
    "\n",
    "print(f\"✓ Loaded from epoch {current_epoch}\")\n",
    "print(f\"  Current WER: {best_wer:.2f}%\")\n",
    "print(f\"  Current loss: {best_loss:.4f}\")\n",
    "\n",
    "model = model.to(config.device)\n",
    "print(f\"\\n✓ Model ready on {config.device}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 7: Create Model and Load Checkpoint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 7: Load datasets\n",
    "print(\"Loading datasets...\")\n",
    "print(f\"Using DATA_DIR: {DATA_DIR}\")\n",
    "\n",
    "feature_extractor = FeatureExtractor(\n",
    "    sample_rate=config.sample_rate,\n",
    "    n_mels=config.n_mels,\n",
    "    win_length_ms=config.win_length_ms,\n",
    "    hop_length_ms=config.hop_length_ms,\n",
    "    normalize=config.normalize_features\n",
    ")\n",
    "\n",
    "# Find manifest files using DATA_DIR\n",
    "train_manifest_paths = [\n",
    "    os.path.join(DATA_DIR, 'synthetic_audio', 'train_manifest.csv')\n",
    "]\n",
    "val_manifest_paths = [\n",
    "    os.path.join(DATA_DIR, 'synthetic_audio', 'val_manifest.csv')\n",
    "]\n",
    "\n",
    "print(f\"\\nLooking for train manifest at: {train_manifest_paths[0]}\")\n",
    "print(f\"Looking for val manifest at: {val_manifest_paths[0]}\")"\n",
    "\n",
    "train_manifest = None\n",
    "for path in train_manifest_paths:\n",
    "    if os.path.exists(path):\n",
    "        train_manifest = path\n",
    "        break\n",
    "\n",
    "val_manifest = None\n",
    "for path in val_manifest_paths:\n",
    "    if os.path.exists(path):\n",
    "        val_manifest = path\n",
    "        break\n",
    "\n",
    "if not train_manifest or not val_manifest:\n",
    "    raise FileNotFoundError(f\"Could not find manifest files. Train: {train_manifest}, Val: {val_manifest}\")\n",
    "\n",
    "print(f\"\\n✓ Found train manifest: {train_manifest}\")\n",
    "print(f\"✓ Found val manifest: {val_manifest}\")\n",
    "\n",
    "# Audio files are in DATA_DIR (same location as manifest)\n",
    "audio_base_dir = DATA_DIR\n",
    "print(f\"✓ Audio base directory: {audio_base_dir}\")\n",
    "print(f\"\\nCreating datasets...\")\n",
    "\n",
    "# Create datasets with audio_dir to resolve relative paths\n",
    "train_dataset = MarathiASRDataset(\n",
    "    manifest_path=train_manifest,\n",
    "    audio_dir=audio_base_dir,\n",
    "    feature_extractor=feature_extractor,\n",
    "    tokenizer=tokenizer,\n",
    "    augment=True\n",
    ")\n",
    "\n",
    "val_dataset = MarathiASRDataset(\n",
    "    manifest_path=val_manifest,\n",
    "    audio_dir=audio_base_dir,\n",
    "    feature_extractor=feature_extractor,\n",
    "    tokenizer=tokenizer,\n",
    "    augment=False\n",
    ")\n",
    "\n",
    "print(f\"✓ Train: {len(train_dataset)} samples\")\n",
    "print(f\"✓ Val: {len(val_dataset)} samples\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 8: Create Data Loaders"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 8: Data loaders\n",
    "def collate_fn(batch):\n",
    "    features_list, tokens_list = [], []\n",
    "    for features, tokens in batch:\n",
    "        features_list.append(features)\n",
    "        tokens_list.append(tokens)\n",
    "    \n",
    "    max_feat_len = max(f.shape[1] for f in features_list)\n",
    "    padded_features = []\n",
    "    for f in features_list:\n",
    "        if f.shape[1] < max_feat_len:\n",
    "            f = torch.nn.functional.pad(f, (0, max_feat_len - f.shape[1]))\n",
    "        padded_features.append(f)\n",
    "    features_batch = torch.stack(padded_features)\n",
    "    \n",
    "    max_token_len = max(len(t) for t in tokens_list)\n",
    "    padded_tokens = []\n",
    "    for t in tokens_list:\n",
    "        if len(t) < max_token_len:\n",
    "            t = torch.nn.functional.pad(t, (0, max_token_len - len(t)), value=tokenizer.pad_token_id)\n",
    "        padded_tokens.append(t)\n",
    "    tokens_batch = torch.stack(padded_tokens)\n",
    "    \n",
    "    return features_batch, tokens_batch\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=config.batch_size, shuffle=True, num_workers=0, pin_memory=True, collate_fn=collate_fn)\n",
    "val_loader = DataLoader(val_dataset, batch_size=config.batch_size, shuffle=False, num_workers=0, pin_memory=True, collate_fn=collate_fn)\n",
    "\n",
    "print(f\"✓ Train batches: {len(train_loader)}\")\n",
    "print(f\"✓ Val batches: {len(val_loader)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 9: Setup Trainer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 9: Setup trainer\n",
    "optimizer = torch.optim.AdamW(model.parameters(), lr=config.learning_rate, weight_decay=0.01)\n",
    "\n",
    "if 'optimizer_state_dict' in checkpoint:\n",
    "    optimizer.load_state_dict(checkpoint['optimizer_state_dict'])\n",
    "    print(\"✓ Optimizer state restored\")\n",
    "\n",
    "trainer = Trainer(\n",
    "    model=model,\n",
    "    train_loader=train_loader,\n",
    "    val_loader=val_loader,\n",
    "    optimizer=optimizer,\n",
    "    config=config,\n",
    "    device=config.device\n",
    ")\n",
    "\n",
    "print(\"✓ Trainer ready!\")\n",
    "print(f\"\\nStarting training from epoch {current_epoch + 1}\")\n",
    "print(f\"Target: Reduce WER from {best_wer:.2f}% to <12%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 10: START TRAINING!\n",
    "\n",
    "⚠️ **This will take 2-3 hours**\n",
    "\n",
    "Expected progress:\n",
    "- ~3-4 minutes per epoch\n",
    "- WER should decrease gradually\n",
    "- Best model saved automatically\n",
    "\n",
    "After completion, download `best_model_wer.pt` from the Output tab!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 10: TRAINING LOOP (This will take 2-3 hours)\n",
    "print(\"=\" * 80)\n",
    "print(f\"TRAINING FOR {config.num_epochs} EPOCHS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "training_start = time.time()\n",
    "history = {'train_loss': [], 'val_loss': [], 'val_wer': [], 'val_cer': []}\n",
    "\n",
    "for epoch in range(config.num_epochs):\n",
    "    actual_epoch = current_epoch + epoch + 1\n",
    "    epoch_start = time.time()\n",
    "    \n",
    "    print(f\"\\nEpoch {actual_epoch}/{current_epoch + config.num_epochs}\")\n",
    "    print(\"-\" * 80)\n",
    "    \n",
    "    train_loss = trainer.train_epoch()\n",
    "    val_metrics = trainer.validate()\n",
    "    \n",
    "    epoch_time = time.time() - epoch_start\n",
    "    total_time = time.time() - training_start\n",
    "    \n",
    "    history['train_loss'].append(train_loss)\n",
    "    history['val_loss'].append(val_metrics['loss'])\n",
    "    history['val_wer'].append(val_metrics['wer'])\n",
    "    history['val_cer'].append(val_metrics['cer'])\n",
    "    \n",
    "    print(f\"Train Loss: {train_loss:.4f}\")\n",
    "    print(f\"Val Loss: {val_metrics['loss']:.4f}\")\n",
    "    print(f\"Val WER: {val_metrics['wer']:.2f}%\")\n",
    "    print(f\"Val CER: {val_metrics['cer']:.2f}%\")\n",
