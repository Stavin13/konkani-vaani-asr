   "source": [
    "# Install dependencies\n",
    "!pip install -q torch torchaudio librosa soundfile jiwer pyyaml tensorboard matplotlib\n",
    "\n",
    "# Suppress dependency warnings\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')"
   ]
  },
  {
   "cell_type": "code",
