  {
   "cell_type": "markdown",
   "id": "243f2ed7",
   "metadata": {},
   "source": [
    "## Step 7: Monitor Progress and Download Results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a3bf1525",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check finetuning progress\\n",
    "from IPython.display import FileLink\\n",
    "\\n",
    "finetune_checkpoint_dir = Path('/kaggle/working/finetuned_checkpoints')\\n",
    "finetune_checkpoints = sorted(finetune_checkpoint_dir.glob('checkpoint_epoch_*.pt'))\\n",
    "\\n",
    "if finetune_checkpoints:\\n",
    "    print('Finetuning Progress:')\\n",
    "    print('=' * 60)\\n",
    "    \\n",
    "    # Find best checkpoint\\n",
    "    best_ckpt = None\\n",
    "    best_val_loss = float('inf')\\n",
    "    \\n",
    "    for ckpt_path in finetune_checkpoints[-5:]:  # Check last 5\\n",
    "        try:\\n",
    "            checkpoint = torch.load(ckpt_path, map_location='cpu')\\n",
    "            epoch = checkpoint.get('epoch', '?')\\n",
    "            val_loss = checkpoint.get('val_loss', float('inf'))\\n",
    "            print(f'Epoch {epoch:3d}: Validation Loss {val_loss:.4f}')\\n",
    "            \\n",
    "            if val_loss < best_val_loss:\\n",
    "                best_val_loss = val_loss\\n",
    "                best_ckpt = ckpt_path\\n",
    "        except Exception as e:\\n",
    "            print(f'Could not load {ckpt_path.name}: {e}')\\n",
    "    \\n",
    "    # Copy best checkpoint\\n",
    "    if best_ckpt:\\n",
    "        best_model_path = finetune_checkpoint_dir / 'best_finetuned_model.pt'\\n",
    "        shutil.copy(best_ckpt, best_model_path)\\n",
    "        print(f'\\n✅ Best Model: {best_ckpt.name}, Val Loss {best_val_loss:.4f}')\\n",
    "        \\n",
    "        # Create download link\\n",
    "        print('\\nDownload your finetuned model:')\\n",
    "        display(FileLink(str(best_model_path)))\\n",
    "else:\\n",
    "    print('No finetuning checkpoints found yet. Check back after training starts.')"
   ]
