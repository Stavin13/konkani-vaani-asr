   "source": [
    "import os\n",
    "import sys\n",
    "import json\n",
    "import torch\n",
    "import torchaudio\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "from tqdm import tqdm\n",
    "import yaml\n",
    "import shutil\n",
    "\n",
    "print(f\"PyTorch version: {torch.__version__}\")\n",
    "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"GPU count: {torch.cuda.device_count()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e1dc5cc4",
   "metadata": {},
   "source": [
    "## Step 2: Check Datasets and Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "19fd8a98",
   "metadata": {},
   "outputs": [],
   "source": [
    "# List available datasets\\n",
    "!ls -lh /kaggle/input/\\n",
    "\\n",
    "# Set paths - UPDATE THESE to match your dataset names\\n",
    "DATA_ROOT = Path('/kaggle/input/konkani-asr-complete-data')  # Your main data\\n",
    "SCRIPTS_ROOT = Path('/kaggle/input/kaggle-training-scripts')  # Your scripts dataset\\n",
    "MODEL_ROOT = Path('/kaggle/input/pretrained-model')  # Your pre-trained model dataset\\n",
    "\\n",
    "print(f'\\nData dataset: {DATA_ROOT}')\\n",
    "print(f'Scripts dataset: {SCRIPTS_ROOT}')\\n",
    "print(f'Model dataset: {MODEL_ROOT}')\\n",
    "\\n",
    "# Check if all datasets exist\\n",
    "for name, path in [('Data', DATA_ROOT), ('Scripts', SCRIPTS_ROOT), ('Model', MODEL_ROOT)]:\\n",
    "    if path.exists():\\n",
    "        print(f'✓ {name} dataset found')\\n",
    "    else:\\n",
    "        print(f'✗ {name} dataset NOT found at {path}')\\n",
    "        print(f'   Please add it as input to this notebook')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4df97775",
   "metadata": {},
   "source": [
    "## Step 3: Extract and Prepare Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e435b17e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Copy training scripts and extract data\\n",
    "import zipfile\\n",
    "\\n",
    "print('Copying training scripts...')\\n",
    "script_dirs = ['training_scripts', 'models', 'scripts', 'data']\\n",
    "\\n",
    "for dir_name in script_dirs:\\n",
    "    src_dir = SCRIPTS_ROOT / 'tmp' / 'kaggle_scripts_package' / dir_name\\n",
    "    if src_dir.exists():\\n",
    "        dst_dir = Path('/kaggle/working') / dir_name\\n",
    "        shutil.copytree(src_dir, dst_dir, dirs_exist_ok=True)\\n",
    "        print(f'  ✓ Copied {dir_name}/')\\n",
    "    else:\\n",
    "        print(f'  ⚠️  {dir_name}/ not found at {src_dir}')\\n",
    "\\n",
    "# Extract data and copy pre-trained model\\n",
    "for item in DATA_ROOT.iterdir():\\n",
    "    if item.is_dir():\\n",
    "        dst = Path('/kaggle/working') / item.name\\n",
    "        if not dst.exists():\\n",
    "            shutil.copytree(item, dst)\\n",
    "            print(f'  ✓ Copied {item.name}/')\\n",
    "\\n",
    "# Copy pre-trained model\\n",
    "model_files = list(MODEL_ROOT.glob('*.pt'))\\n",
    "if model_files:\\n",
    "    for model_file in model_files:\\n",
    "        dst = Path('/kaggle/working') / model_file.name\\n",
    "        shutil.copy(model_file, dst)\\n",
    "        print(f'  ✓ Copied model: {model_file.name}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d61591e4",
   "metadata": {},
   "source": [
    "## Step 4: Locate Pre-trained Model and Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6bd96656",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Find the pre-trained model checkpoint\\n",
    "working_dir = Path('/kaggle/working')\\n",
    "model_files = list(working_dir.glob('*.pt'))\\n",
    "\\n",
    "if model_files:\\n",
    "    pretrained_model = model_files[0]\\n",
    "    print(f'✓ Found pre-trained model: {pretrained_model.name}')\\n",
    "    \\n",
    "    # Load and inspect the checkpoint\\n",
    "    try:\\n",
    "        checkpoint = torch.load(pretrained_model, map_location='cpu')\\n",
    "        print(f'\\nModel checkpoint info:')\\n",
    "        print(f'  Epoch: {checkpoint.get(\"epoch\", \"Unknown\")}')\\n",
    "        print(f'  Validation Loss: {checkpoint.get(\"val_loss\", \"Unknown\")}')\\n",
    "        print(f'  Model State Dict Keys: {len(checkpoint.get(\"model_state_dict\", {}))}')\\n",
    "    except Exception as e:\\n",
    "        print(f'  ⚠️  Could not load checkpoint: {e}')\\n",
    "else:\\n",
    "    print('✗ No pre-trained model (.pt file) found!')\\n",
    "    raise FileNotFoundError('No pre-trained model found')\\n",
    "\\n",
    "# Find manifest files\\n",
    "manifest_dirs = ['/kaggle/working/konkani-10k', '/kaggle/working/data/manifests']\\n",
    "manifest_dir = None\\n",
    "for dir_path in manifest_dirs:\\n",
    "    if os.path.exists(dir_path):\\n",
    "        test_files = ['train_manifest.json', 'val_manifest.json']\\n",
    "        if any(os.path.exists(os.path.join(dir_path, f)) for f in test_files):\\n",
    "            manifest_dir = Path(dir_path)\\n",
    "            print(f'✓ Found manifests at: {manifest_dir}')\\n",
    "            break"
   ]
  }
  },
  {
   "cell_type": "markdown",
   "id": "29336b5e",
   "metadata": {},
   "source": [
    "## Step 5: Configure Advanced Finetuning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0f57d266",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Advanced finetuning configuration\\n",
    "finetune_config = {\\n",
    "    'model': {\\n",
    "        'vocab_size': 82,\\n",
    "        'input_dim': 80,\\n",
    "        'd_model': 128,\\n",
    "        'encoder_layers': 8,\\n",
    "        'decoder_layers': 6,\\n",
    "        'num_heads': 4,\\n",
    "        'dropout': 0.2\\n",
    "    },\\n",
    "    'finetuning': {\\n",
    "        'learning_rate': 0.00005,     # Lower LR for finetuning\\n",
    "        'weight_decay': 0.0001,\\n",
    "        'grad_clip': 3.0,\\n",
    "        'ctc_weight': 0.95,           # Higher CTC weight\\n",
    "        'batch_size': 6,\\n",
    "        'gradient_accumulation_steps': 3,\\n",
    "        'mixed_precision': True,\\n",
    "        'num_epochs': 50,\\n",
    "        'save_every': 3,\\n",
    "        'test_every': 3,\\n",
    "        'warmup_epochs': 3,\\n",
    "        'scheduler': 'cosine',\\n",
    "        'early_stopping_patience': 10\\n",
    "    },\\n",
    "    'data': {\\n",
    "        'train_manifest': str(manifest_dir / 'train_manifest.json'),\\n",
    "        'val_manifest': str(manifest_dir / 'val_manifest.json'),\\n",
    "        'vocab_file': str(manifest_dir / 'vocab.json'),\\n",
    "        'num_workers': 2,\\n",
    "        'augmentation': True\\n",
    "    },\\n",
    "    'paths': {\\n",
    "        'checkpoint_dir': '/kaggle/working/finetuned_checkpoints',\\n",
    "        'log_dir': '/kaggle/working/finetune_logs',\\n",
    "        'pretrained_model': str(pretrained_model)\\n",
    "    },\\n",
    "    'device': 'cuda'\\n",
    "}\\n",
    "\\n",
    "# Create directories and save config\\n",
    "os.makedirs(finetune_config['paths']['checkpoint_dir'], exist_ok=True)\\n",
    "os.makedirs(finetune_config['paths']['log_dir'], exist_ok=True)\\n",
    "os.makedirs('/kaggle/working/config', exist_ok=True)\\n",
    "\\n",
    "with open('/kaggle/working/config/finetune_config.yaml', 'w') as f:\\n",
    "    yaml.dump(finetune_config, f)\\n",
    "\\n",
    "print('✓ Finetuning config saved with advanced settings:')\\n",
    "print(f'  - Learning rate: {finetune_config[\"finetuning\"][\"learning_rate\"]} (lower for stability)')\\n",
    "print(f'  - CTC weight: {finetune_config[\"finetuning\"][\"ctc_weight\"]} (higher for better transcription)')\\n",
    "print(f'  - Batch size: {finetune_config[\"finetuning\"][\"batch_size\"]} (smaller for stability)')\\n",
    "print(f'  - Epochs: {finetune_config[\"finetuning\"][\"num_epochs\"]} (focused finetuning)')"
   ]
  },
  {
