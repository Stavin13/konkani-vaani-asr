    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# KonkaniVani ASR - Fixed Vocabulary + Dual GPU Training\\n",
        "\\n",
        "## 🎯 CRITICAL FIX APPLIED\\n",
        "- **Vocabulary Size**: 200 (was 81 - too small!)\\n",
        "- **Expected Results**: 20-50% accuracy (vs previous 1%)\\n",
        "- **🚀 Dual GPU**: 2x faster training with DataParallel\\n",
        "- **Training Time**: ~3-4 hours for 100 epochs (dual GPU + mixed precision)\\n",
        "- **🔥 Optimizations**: 3x higher LR, gradient accumulation, mixed precision\\n",
        "\\n",
        "## What Was Fixed\\n",
        "- ❌ **Before**: Model used vocab_size=81, but data needs 193 characters\\n",
        "- ✅ **After**: Model uses vocab_size=200, can predict all characters\\n",
        "- 🎯 **Result**: Model can finally learn Konkani properly!"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Setup Environment"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Check GPU\\n",
        "!nvidia-smi\\n",
        "\\n",
        "import torch\\n",
        "print(f'PyTorch version: {torch.__version__}')\\n",
        "print(f'CUDA available: {torch.cuda.is_available()}')\\n",
        "if torch.cuda.is_available():\\n",
        "    print(f'GPU: {torch.cuda.get_device_name(0)}')\\n",
        "    print(f'GPU Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Install dependencies\\n",
        "!pip install librosa soundfile torchaudio\\n",
        "\\n",
        "import os\\n",
        "import sys\\n",
        "import json\\n",
        "import torch\\n",
        "import torch.nn as nn\\n",
        "import torch.optim as optim\\n",
        "from torch.utils.data import DataLoader\\n",
        "import torchaudio\\n",
        "import librosa\\n",
        "import numpy as np\\n",
        "from pathlib import Path\\n",
        "from tqdm import tqdm\\n",
        "from collections import Counter\\n",
        "\\n",
        "# Set device and check for multiple GPUs\\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\\n",
        "print(f'Using device: {device}')\\n",
        "\\n",
        "# Check for multiple GPUs\\n",
        "if torch.cuda.is_available():\\n",
        "    gpu_count = torch.cuda.device_count()\\n",
        "    print(f'Available GPUs: {gpu_count}')\\n",
        "    for i in range(gpu_count):\\n",
        "        print(f'  GPU {i}: {torch.cuda.get_device_name(i)}')\\n",
        "        print(f'  Memory: {torch.cuda.get_device_properties(i).total_memory / 1e9:.1f} GB')\\n",
        "    \\n",
        "    if gpu_count > 1:\\n",
        "        print(f'🚀 DUAL GPU TRAINING ENABLED! Using {gpu_count} GPUs')\\n",
        "    else:\\n",
        "        print('Single GPU training')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Load Model Architecture"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Load the model architecture\\n",
        "import sys\\n",
        "sys.path.append('/kaggle/input/scripts1')\\n",
        "\\n",
        "from models.konkanivani_asr import KonkaniVaniASR"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Load Corrected Model and Vocabulary"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Load vocabulary (200 characters)\\n",
        "with open('/kaggle/input/scripts1/vocab.json', 'r', encoding='utf-8') as f:\\n",
        "    vocab_data = json.load(f)\\n",
        "\\n",
        "vocab = vocab_data['char2idx']\\n",
        "reverse_vocab = {v: k for k, v in vocab.items()}\\n",
        "\\n",
        "print(f'✅ Loaded vocabulary: {len(vocab)} characters')\\n",
        "print(f'Sample characters: {list(vocab.keys())[5:15]}')\\n",
        "\\n",
        "# Load corrected model\\n",
        "checkpoint = torch.load('/kaggle/input/scripts1/initial_model_vocab200.pt', map_location='cpu')\\n",
        "\\n",
        "# Model configuration from optimized config\\n",
        "model_config = {\\n",
        "    'vocab_size': len(vocab),\\n",
        "    'input_dim': 80,\\n",
        "    'd_model': 256,\\n",
        "    'encoder_layers': 12,\\n",
        "    'decoder_layers': 6,\\n",
        "    'num_heads': 4,\\n",
        "    'conv_kernel_size': 31,\\n",
        "    'dropout': 0.2\\n",
        "}\\n",
        "\\n",
        "model = KonkaniVaniASR(**model_config)\\n",
        "model.load_state_dict(checkpoint['model_state_dict'])\\n",
        "model = model.to(device)\\n",
        "\\n",
        "# Enable multi-GPU training if available\\n",
        "if torch.cuda.device_count() > 1:\\n",
        "    print(f'🚀 Wrapping model for {torch.cuda.device_count()} GPUs')\\n",
        "    model = nn.DataParallel(model)\\n",
        "    print('✅ Multi-GPU DataParallel enabled!')\\n",
        "\\n",
        "print(f'✅ Model loaded with vocab_size={len(vocab)}')\\n",
        "print(f'Model parameters: {sum(p.numel() for p in model.parameters()):,}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Prepare Training Data"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Load audio processing modules\\n",
        "import sys\\n",
        "sys.path.append('/kaggle/input/scripts1')\\n",
        "\\n",
        "from data.audio_processing.audio_processor import AudioProcessor\\n",
        "from data.audio_processing.dataset import KonkaniASRDataset\\n",
        "from data.audio_processing.text_tokenizer import TextTokenizer\\n",
        "\\n",
        "# Load training data\\n",
        "train_manifest = '/kaggle/input/konkani-training-data/train.json'\\n",
        "val_manifest = '/kaggle/input/konkani-training-data/val.json'\\n",
        "\\n",
        "# Create tokenizer\\n",
        "tokenizer = TextTokenizer(vocab)\\n",
        "\\n",
        "# Create datasets\\n",
        "train_dataset = KonkaniASRDataset(\\n",
        "    manifest_path=train_manifest,\\n",
        "    tokenizer=tokenizer,\\n",
        "    audio_processor=AudioProcessor(),\\n",
        "    max_duration=20.0\\n",
        ")\\n",
        "\\n",
        "val_dataset = KonkaniASRDataset(\\n",
        "    manifest_path=val_manifest,\\n",
        "    tokenizer=tokenizer,\\n",
        "    audio_processor=AudioProcessor(),\\n",
        "    max_duration=20.0\\n",
        ")\\n",
        "\\n",
        "# Create data loaders\\n",
        "train_loader = DataLoader(\\n",
        "    train_dataset,\\n",
        "    batch_size=config['batch_size'],\\n",
        "    shuffle=True,\\n",
        "    num_workers=4 * (torch.cuda.device_count() if torch.cuda.is_available() else 1),\\n",
        "    collate_fn=train_dataset.collate_fn,\\n",
        "    pin_memory=True  # Faster GPU transfer\\n",
        ")\\n",
        "\\n",
        "val_loader = DataLoader(\\n",
        "    val_dataset,\\n",
        "    batch_size=config['batch_size'],\\n",
        "    shuffle=False,\\n",
        "    num_workers=4 * (torch.cuda.device_count() if torch.cuda.is_available() else 1),\\n",
        "    collate_fn=val_dataset.collate_fn,\\n",
        "    pin_memory=True  # Faster GPU transfer\\n",
        ")\\n",
        "\\n",
        "print(f'✅ Training data loaded: {len(train_dataset)} samples')\\n",
        "print(f'✅ Validation data loaded: {len(val_dataset)} samples')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Training Configuration"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Training configuration\\n",
        "config = {\\n",
        "    'learning_rate': 0.0003 * (torch.cuda.device_count() if torch.cuda.is_available() and torch.cuda.device_count() > 1 else 1),  # 🔥 Increased from 0.0001\\n",
        "    'batch_size': 2 * torch.cuda.device_count() if torch.cuda.is_available() and torch.cuda.device_count() > 1 else 2,  # Conservative for memory\\n",
        "    'num_epochs': 100,  # 🔥 More epochs for better results\\n",
        "    'save_every': 5,\\n",
        "    'test_every': 5,  # Test model every 5 epochs\\n",
        "    'ctc_weight': 0.8,\\n",
        "    'grad_clip': 5.0,\\n",
        "    'weight_decay': 0.0001,  # 🔥 Added weight decay\\n",
        "    'gradient_accumulation_steps': 4,  # 🔥 Effective batch size = batch_size * 4\\n",
        "    'mixed_precision': True  # 🔥 Faster training + less memory\\n",
        "}\\n",
        "\\n",
        "# Setup optimizer, loss, and mixed precision\\n",
        "optimizer = optim.AdamW(model.parameters(), lr=config['learning_rate'], weight_decay=config['weight_decay'])\\n",
        "scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, patience=3, factor=0.5)\\n",
        "ctc_loss = nn.CTCLoss(blank=0, zero_infinity=True)\\n",
        "\\n",
        "# Mixed precision training\\n",
        "scaler = torch.cuda.amp.GradScaler() if config['mixed_precision'] else None\\n",
        "\\n",
        "print(f'🔥 MIXED PRECISION: {\"Enabled\" if config[\"mixed_precision\"] else \"Disabled\"}')\\n",
        "\\n",
        "gpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1\\n",
        "print(f'🔥 OPTIMIZED DUAL GPU TRAINING CONFIGURATION:')\\n",
        "print(f'  GPUs: {gpu_count}')\\n",
        "print(f'  Batch size: {config[\"batch_size\"]} (base: 2 × {gpu_count} GPUs)')\\n",
        "print(f'  Gradient accumulation: {config[\"gradient_accumulation_steps\"]} steps')\\n",
        "print(f'  Effective batch size: {config[\"batch_size\"] * config[\"gradient_accumulation_steps\"]}')\\n",
        "print(f'  Learning rate: {config[\"learning_rate\"]} (3x higher + GPU scaling)')\\n",
        "print(f'  Mixed precision: {config[\"mixed_precision\"]}')\\n",
        "print(f'  Epochs: {config[\"num_epochs\"]} (2x more for better results)')\\n",
        "print(f'  CTC weight: {config[\"ctc_weight\"]} (critical fix from 0.3)')\\n",
        "print(f'  Expected speedup: ~{gpu_count}x faster + mixed precision boost!')\\n",
        "print('✅ Optimized training setup complete')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Training Loop with Testing"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# Training loop\\n",
        "best_val_loss = float('inf')\\n",
        "\\n",
        "for epoch in range(1, config['num_epochs'] + 1):\\n",
        "    print(f'\\\\n=== EPOCH {epoch}/{config[\"num_epochs\"]} ===')\\n",
        "    \\n",
        "    # Training step\\n",
        "    model.train()\\n",
        "    train_loss = 0\\n",
        "    num_batches = 0\\n",
        "    \\n",
        "    for batch_idx, batch in enumerate(tqdm(train_loader, desc=f'Training Epoch {epoch}')):\\n",
        "        try:\\n",
        "            # Move batch to device\\n",
        "            audio_features = batch['audio_features'].to(device)\\n",
        "            targets = batch['targets'].to(device)\\n",
        "            target_lengths = batch['target_lengths'].to(device)\\n",
        "            input_lengths = batch['input_lengths'].to(device)\\n",
        "            \\n",
        "            # Mixed precision forward pass\\n",
        "            with torch.cuda.amp.autocast(enabled=config['mixed_precision']):\\n",
        "                outputs = model(audio_features)\\n",
        "            \\n",
        "                # Calculate CTC loss\\n",
        "                log_probs = torch.log_softmax(outputs, dim=-1)\\n",
        "                log_probs = log_probs.transpose(0, 1)  # (T, N, C)\\n",
        "                \\n",
        "                loss = ctc_loss(log_probs, targets, input_lengths, target_lengths)\\n",
        "                # Scale loss for gradient accumulation\\n",
        "                loss = loss / config['gradient_accumulation_steps']\\n",
        "            \\n",
        "            # Backward pass with mixed precision\\n",
        "            if config['mixed_precision']:\\n",
        "                scaler.scale(loss).backward()\\n",
        "            else:\\n",
        "                loss.backward()\\n",
        "            \\n",
        "            # Gradient accumulation step\\n",
        "            if (batch_idx + 1) % config['gradient_accumulation_steps'] == 0:\\n",
        "                if config['mixed_precision']:\\n",
        "                    scaler.unscale_(optimizer)\\n",
        "                    torch.nn.utils.clip_grad_norm_(model.parameters(), config['grad_clip'])\\n",
        "                    scaler.step(optimizer)\\n",
        "                    scaler.update()\\n",
        "                else:\\n",
        "                    torch.nn.utils.clip_grad_norm_(model.parameters(), config['grad_clip'])\\n",
        "                    optimizer.step()\\n",
        "                \\n",
        "                optimizer.zero_grad()"\\n",
        "            \\n",
        "            train_loss += loss.item() * config['gradient_accumulation_steps']  # Unscale for logging\\n",
        "            num_batches += 1\\n",
        "            \\n",
        "            if batch_idx % 50 == 0:\\n",
        "                print(f'  Batch {batch_idx}/{len(train_loader)}, Loss: {loss.item() * config[\"gradient_accumulation_steps\"]:.4f}')\\n",
        "                \\n",
        "        except Exception as e:\\n",
        "            print(f'  ⚠️  Skipping batch {batch_idx}: {e}')\\n",
        "            continue\\n",
        "    \\n",
        "    avg_train_loss = train_loss / max(num_batches, 1)\\n",
        "    \\n",
        "    # Validation step\\n",
        "    model.eval()\\n",
        "    val_loss = 0\\n",
        "    val_batches = 0\\n",
        "    \\n",
        "    with torch.no_grad():\\n",
        "        for batch in tqdm(val_loader, desc=f'Validation Epoch {epoch}'):\\n",
        "            try:\\n",
        "                audio_features = batch['audio_features'].to(device)\\n",
        "                targets = batch['targets'].to(device)\\n",
        "                target_lengths = batch['target_lengths'].to(device)\\n",
        "                input_lengths = batch['input_lengths'].to(device)\\n",
        "                \\n",
        "                outputs = model(audio_features)\\n",
        "                log_probs = torch.log_softmax(outputs, dim=-1)\\n",
        "                log_probs = log_probs.transpose(0, 1)\\n",
        "                \\n",
        "                loss = ctc_loss(log_probs, targets, input_lengths, target_lengths)\\n",
        "                val_loss += loss.item()\\n",
        "                val_batches += 1\\n",
        "                \\n",
        "            except Exception as e:\\n",
        "                continue\\n",
        "    \\n",
        "    avg_val_loss = val_loss / max(val_batches, 1)\\n",
        "    \\n",
        "    print(f'Epoch {epoch}: Train Loss = {avg_train_loss:.4f}, Val Loss = {avg_val_loss:.4f}')\\n",
        "    \\n",
        "    # Update learning rate\\n",
        "    scheduler.step(avg_val_loss)\\n",
        "    \\n",
        "    # Test model every 5 epochs\\n",
        "    if epoch % config['test_every'] == 0:\\n",
        "        print(f'\\\\n🧪 TESTING MODEL AT EPOCH {epoch}')\\n",
        "        test_model_predictions(model, vocab, reverse_vocab)\\n",
        "    \\n",
        "    # Save checkpoint\\n",
        "    if epoch % config['save_every'] == 0 or avg_val_loss < best_val_loss:\\n",
        "        # Handle DataParallel model saving\\n",
        "        model_state = model.module.state_dict() if hasattr(model, 'module') else model.state_dict()\\n",
        "        \\n",
        "        checkpoint = {\\n",
        "            'epoch': epoch,\\n",
        "            'model_state_dict': model_state,\\n",
        "            'optimizer_state_dict': optimizer.state_dict(),\\n",
        "            'val_loss': avg_val_loss,\\n",
        "            'vocab': vocab,\\n",
        "            'gpu_count': torch.cuda.device_count()\\n",
        "        }\\n",
        "        \\n",
        "        torch.save(checkpoint, f'/kaggle/working/checkpoint_epoch_{epoch}.pt')\\n",
        "        \\n",
        "        if avg_val_loss < best_val_loss:\\n",
        "            best_val_loss = avg_val_loss\\n",
        "            torch.save(checkpoint, '/kaggle/working/best_model_fixed.pt')\\n",
        "            print(f'✅ New best model saved (val_loss: {avg_val_loss:.4f})')\\n",
        "\\n",
        "print('\\\\n🎉 Training complete!')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
