    "# Cell 5: Model Architecture (from your konkanivani_asr.py)\n",
    "class PositionalEncoding(nn.Module):\n",
    "    def __init__(self, d_model, max_len=5000):\n",
    "        super().__init__()\n",
    "        pe = torch.zeros(max_len, d_model)\n",
    "        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)\n",
    "        div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-np.log(10000.0) / d_model))\n",
    "        pe[:, 0::2] = torch.sin(position * div_term)\n",
    "        pe[:, 1::2] = torch.cos(position * div_term)\n",
    "        pe = pe.unsqueeze(0)\n",
    "        self.register_buffer('pe', pe)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        return x + self.pe[:, :x.size(1)]\n",
    "\n",
    "class ConformerBlock(nn.Module):\n",
    "    def __init__(self, d_model, nhead, dim_feedforward, dropout=0.1):\n",
    "        super().__init__()\n",
    "        self.ff1 = nn.Sequential(\n",
    "            nn.LayerNorm(d_model),\n",
    "            nn.Linear(d_model, dim_feedforward),\n",
    "            nn.SiLU(),\n",
    "            nn.Dropout(dropout),\n",
    "            nn.Linear(dim_feedforward, d_model),\n",
    "            nn.Dropout(dropout)\n",
    "        )\n",
    "        self.self_attn_norm = nn.LayerNorm(d_model)\n",
    "        self.self_attn = nn.MultiheadAttention(d_model, nhead, dropout=dropout, batch_first=True)\n",
    "        self.conv_module = nn.Sequential(\n",
    "            nn.LayerNorm(d_model),\n",
    "            nn.Conv1d(d_model, d_model * 2, 1),\n",
    "            nn.GLU(dim=1),\n",
    "            nn.Conv1d(d_model, d_model, 3, padding=1, groups=d_model),\n",
    "            nn.BatchNorm1d(d_model),\n",
    "            nn.SiLU(),\n",
    "            nn.Conv1d(d_model, d_model, 1),\n",
    "            nn.Dropout(dropout)\n",
    "        )\n",
    "        self.ff2 = nn.Sequential(\n",
    "            nn.LayerNorm(d_model),\n",
    "            nn.Linear(d_model, dim_feedforward),\n",
    "            nn.SiLU(),\n",
    "            nn.Dropout(dropout),\n",
    "            nn.Linear(dim_feedforward, d_model),\n",
    "            nn.Dropout(dropout)\n",
    "        )\n",
    "        self.norm = nn.LayerNorm(d_model)\n",
    "    \n",
    "    def forward(self, x, mask=None):\n",
    "        x = x + 0.5 * self.ff1(x)\n",
    "        attn_out, _ = self.self_attn(self.self_attn_norm(x), self.self_attn_norm(x), \n",
    "                                      self.self_attn_norm(x), key_padding_mask=mask)\n",
    "        x = x + attn_out\n",
    "        conv_input = x.transpose(1, 2)\n",
    "        conv_out = self.conv_module(conv_input).transpose(1, 2)\n",
    "        x = x + conv_out\n",
    "        x = x + 0.5 * self.ff2(x)\n",
    "        return self.norm(x)\n",
    "\n",
    "class KonkaniVaniASR(nn.Module):\n",
    "    def __init__(self, vocab_size, d_model=128, nhead=4, num_encoder_layers=6, \n",
    "                 num_decoder_layers=3, dim_feedforward=512, dropout=0.1):\n",
    "        super().__init__()\n",
    "        self.encoder = nn.ModuleDict({\n",
    "            'input_proj': nn.Linear(80, d_model),\n",
    "            'pos_encoding': PositionalEncoding(d_model),\n",
    "            'layers': nn.ModuleList([ConformerBlock(d_model, nhead, dim_feedforward, dropout) \n",
    "                                    for _ in range(num_encoder_layers)])\n",
    "        })\n",
    "        self.decoder = nn.ModuleDict({\n",
    "            'embedding': nn.Embedding(vocab_size, d_model),\n",
    "            'pos_encoding': PositionalEncoding(d_model),\n",
    "            'layers': nn.ModuleList([nn.TransformerDecoderLayer(d_model, nhead, dim_feedforward, \n",
    "                                                                dropout, batch_first=True) \n",
    "                                    for _ in range(num_decoder_layers)]),\n",
    "            'output_proj': nn.Linear(d_model, vocab_size)\n",
    "        })\n",
    "        self.ctc_proj = nn.Linear(d_model, vocab_size)\n",
    "    \n",
    "    def forward(self, features, feature_lengths=None):\n",
    "        x = self.encoder['input_proj'](features)\n",
    "        x = self.encoder['pos_encoding'](x)\n",
    "        mask = None\n",
    "        if feature_lengths is not None:\n",
    "            mask = torch.arange(features.size(1), device=features.device)[None, :] >= feature_lengths[:, None]\n",
    "        for layer in self.encoder['layers']:\n",
    "            x = layer(x, mask)\n",
    "        ctc_logits = self.ctc_proj(x)\n",
    "        return ctc_logits, x\n",
    "\n",
    "print(\"Model architecture defined\")"
   ]
  }
