    "# Cell 7: Setup Data Loaders\n",
    "print(\"Setting up streaming data loaders...\")\n",
    "\n",
    "# KonkaniRawSpeechCorpus manifest paths\n",
    "train_manifest = os.path.join(CONFIG['dataset_path'], 'splits/manifests/train.json')\n",
    "val_manifest = os.path.join(CONFIG['dataset_path'], 'splits/manifests/val.json')\n",
    "\n",
    "# Create streaming datasets\n",
    "train_dataset = StreamingAudioDataset(train_manifest, vocab, augment=True)\n",
    "val_dataset = StreamingAudioDataset(val_manifest, vocab, augment=False)\n",
    "\n",
    "print(f\"Train samples: {len(train_dataset)}\")\n",
    "print(f\"Val samples: {len(val_dataset)}\")\n",
    "\n",
    "# Create data loaders\n",
    "train_loader = DataLoader(\n",
    "    train_dataset,\n",
    "    batch_size=CONFIG['batch_size'],\n",
    "    collate_fn=collate_fn,\n",
    "    num_workers=CONFIG['num_workers'],\n",
    "    prefetch_factor=CONFIG['prefetch_factor'],\n",
    "    pin_memory=True\n",
    ")\n",
    "\n",
    "val_loader = DataLoader(\n",
    "    val_dataset,\n",
    "    batch_size=CONFIG['batch_size'],\n",
    "    collate_fn=collate_fn,\n",
    "    num_workers=CONFIG['num_workers'],\n",
    "    prefetch_factor=CONFIG['prefetch_factor'],\n",
    "    pin_memory=True\n",
    ")\n",
    "\n",
    "# Calculate steps\n",
    "steps_per_epoch = len(train_dataset) // CONFIG['batch_size']\n",
    "total_steps = steps_per_epoch * CONFIG['num_epochs']\n",
    "warmup_steps = steps_per_epoch * 2  # 2 epochs warmup\n",
    "\n",
    "scheduler = get_lr_scheduler(optimizer, warmup_steps, total_steps)\n",
    "\n",
    "print(f\"\\nSteps per epoch: {steps_per_epoch}\")\n",
    "print(f\"Total training steps: {total_steps}\")\n",
    "print(f\"Warmup steps: {warmup_steps}\")\n",
    "print(f\"Effective batch size: {CONFIG['batch_size'] * CONFIG['gradient_accumulation_steps']}\")"
   ]
