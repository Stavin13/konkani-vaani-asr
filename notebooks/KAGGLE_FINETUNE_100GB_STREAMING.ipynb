    "# Cell 8: Training Functions\n",
    "def decode_predictions(logits, vocab):\n",
    "    \"\"\"Greedy CTC decoding\"\"\"\n",
    "    predictions = torch.argmax(logits, dim=-1)\n",
    "    decoded = []\n",
    "    for pred in predictions:\n",
    "        chars = []\n",
    "        prev_char = None\n",
    "        for idx in pred:\n",
    "            idx = idx.item()\n",
    "            if idx != 0 and idx != prev_char:  # Skip blank and repeats\n",
    "                if idx < len(vocab):\n",
    "                    chars.append(vocab[idx])\n",
    "            prev_char = idx\n",
    "        decoded.append(''.join(chars))\n",
    "    return decoded\n",
    "\n",
    "def calculate_wer(predictions, references):\n",
    "    \"\"\"Calculate Word Error Rate\"\"\"\n",
    "    try:\n",
    "        return wer(references, predictions) * 100\n",
    "    except:\n",
    "        return 100.0\n",
    "\n",
    "def train_epoch(model, train_loader, optimizer, scheduler, scaler, epoch):\n",
    "    model.train()\n",
    "    total_loss = 0\n",
    "    optimizer.zero_grad()\n",
    "    \n",
    "    pbar = tqdm(train_loader, desc=f\"Epoch {epoch}\")\n",
    "    for step, batch in enumerate(pbar):\n",
    "        features = batch['features'].to(device)\n",
    "        feature_lengths = batch['feature_lengths'].to(device)\n",
    "        labels = batch['labels'].to(device)\n",
    "        label_lengths = batch['label_lengths'].to(device)\n",
    "        \n",
    "        # Mixed precision forward pass\n",
    "        if scaler:\n",
    "            with torch.cuda.amp.autocast():\n",
    "                ctc_logits, _ = model(features, feature_lengths)\n",
    "                log_probs = torch.log_softmax(ctc_logits, dim=-1).transpose(0, 1)\n",
    "                loss = ctc_loss(log_probs, labels, feature_lengths, label_lengths)\n",
    "                loss = loss / CONFIG['gradient_accumulation_steps']\n",
    "            \n",
    "            scaler.scale(loss).backward()\n",
    "            \n",
    "            if (step + 1) % CONFIG['gradient_accumulation_steps'] == 0:\n",
    "                scaler.unscale_(optimizer)\n",
    "                torch.nn.utils.clip_grad_norm_(model.parameters(), CONFIG['grad_clip'])\n",
    "                scaler.step(optimizer)\n",
    "                scaler.update()\n",
    "                optimizer.zero_grad()\n",
    "                scheduler.step()\n",
    "        else:\n",
    "            ctc_logits, _ = model(features, feature_lengths)\n",
    "            log_probs = torch.log_softmax(ctc_logits, dim=-1).transpose(0, 1)\n",
    "            loss = ctc_loss(log_probs, labels, feature_lengths, label_lengths)\n",
    "            loss = loss / CONFIG['gradient_accumulation_steps']\n",
    "            loss.backward()\n",
    "            \n",
    "            if (step + 1) % CONFIG['gradient_accumulation_steps'] == 0:\n",
    "                torch.nn.utils.clip_grad_norm_(model.parameters(), CONFIG['grad_clip'])\n",
    "                optimizer.step()\n",
    "                optimizer.zero_grad()\n",
    "                scheduler.step()\n",
    "        \n",
    "        total_loss += loss.item() * CONFIG['gradient_accumulation_steps']\n",
    "        pbar.set_postfix({'loss': loss.item() * CONFIG['gradient_accumulation_steps'], \n",
    "                         'lr': scheduler.get_last_lr()[0]})\n",
    "        \n",
    "        # Clear cache periodically\n",
    "        if step % 100 == 0:\n",
    "            torch.cuda.empty_cache()\n",
    "    \n",
    "    return total_loss / len(train_loader)\n",
    "\n",
    "def validate(model, val_loader, vocab):\n",
    "    model.eval()\n",
    "    total_loss = 0\n",
    "    all_predictions = []\n",
    "    all_references = []\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for batch in tqdm(val_loader, desc=\"Validating\"):\n",
    "            features = batch['features'].to(device)\n",
    "            feature_lengths = batch['feature_lengths'].to(device)\n",
    "            labels = batch['labels'].to(device)\n",
    "            label_lengths = batch['label_lengths'].to(device)\n",
    "            \n",
    "            ctc_logits, _ = model(features, feature_lengths)\n",
    "            log_probs = torch.log_softmax(ctc_logits, dim=-1).transpose(0, 1)\n",
    "            loss = ctc_loss(log_probs, labels, feature_lengths, label_lengths)\n",
    "            total_loss += loss.item()\n",
    "            \n",
    "            # Decode predictions\n",
    "            predictions = decode_predictions(ctc_logits, vocab)\n",
    "            all_predictions.extend(predictions)\n",
    "            all_references.extend(batch['texts'])\n",
    "    \n",
    "    avg_loss = total_loss / len(val_loader)\n",
    "    wer_score = calculate_wer(all_predictions, all_references)\n",
    "    \n",
    "    # Show sample predictions\n",
    "    print(\"\\nSample predictions:\")\n",
    "    for i in range(min(3, len(all_predictions))):\n",
    "        print(f\"  Ref: {all_references[i]}\")\n",
    "        print(f\"  Pred: {all_predictions[i]}\")\n",
    "        print()\n",
    "    \n",
    "    return avg_loss, wer_score\n",
    "\n",
    "print(\"Training functions defined\")"
   ]
  },
