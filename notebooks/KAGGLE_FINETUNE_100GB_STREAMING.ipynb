    "# Cell 3: Streaming Dataset for 100GB Data\n",
    "class StreamingAudioDataset(IterableDataset):\n",
    "    \"\"\"Streaming dataset that doesn't load all data into memory\"\"\"\n",
    "    \n",
    "    def __init__(self, manifest_path, vocab, max_length=20.0, augment=False):\n",
    "        self.manifest_path = manifest_path\n",
    "        self.vocab = vocab\n",
    "        self.char_to_idx = {char: idx for idx, char in enumerate(vocab)}\n",
    "        self.max_length = max_length\n",
    "        self.augment = augment\n",
    "        \n",
    "        # Count total samples\n",
    "        with open(manifest_path, 'r') as f:\n",
    "            self.total_samples = sum(1 for _ in f)\n",
    "    \n",
    "    def __iter__(self):\n",
    "        \"\"\"Stream samples one at a time\"\"\"\n",
    "        with open(self.manifest_path, 'r') as f:\n",
    "            for line in f:\n",
    "                try:\n",
    "                    sample = json.loads(line.strip())\n",
    "                    \n",
    "                    # Load audio\n",
    "                    waveform, sr = torchaudio.load(sample['audio_filepath'])\n",
    "                    \n",
    "                    # Resample if needed\n",
    "                    if sr != 16000:\n",
    "                        resampler = torchaudio.transforms.Resample(sr, 16000)\n",
    "                        waveform = resampler(waveform)\n",
    "                    \n",
    "                    # Trim if too long\n",
    "                    max_samples = int(self.max_length * 16000)\n",
    "                    if waveform.shape[1] > max_samples:\n",
    "                        waveform = waveform[:, :max_samples]\n",
    "                    \n",
    "                    # Extract features\n",
    "                    features = self._extract_features(waveform)\n",
    "                    \n",
    "                    # Encode text\n",
    "                    text = sample['text']\n",
    "                    labels = self._encode_text(text)\n",
    "                    \n",
    "                    yield {\n",
    "                        'features': features,\n",
    "                        'labels': labels,\n",
    "                        'text': text\n",
    "                    }\n",
    "                    \n",
    "                except Exception as e:\n",
    "                    print(f\"Error loading sample: {e}\")\n",
    "                    continue\n",
    "    \n",
    "    def _extract_features(self, waveform):\n",
    "        \"\"\"Extract mel spectrogram features\"\"\"\n",
    "        mel_spec = torchaudio.transforms.MelSpectrogram(\n",
    "            sample_rate=16000,\n",
    "            n_fft=512,\n",
    "            hop_length=160,\n",
    "            n_mels=80\n",
    "        )(waveform)\n",
    "        \n",
    "        # Log scale\n",
    "        mel_spec = torch.log(mel_spec + 1e-9)\n",
    "        \n",
    "        # SpecAugment if training\n",
    "        if self.augment and CONFIG['use_spec_augment']:\n",
    "            mel_spec = self._spec_augment(mel_spec)\n",
    "        \n",
    "        return mel_spec.squeeze(0).transpose(0, 1)  # (time, freq)\n",
    "    \n",
    "    def _spec_augment(self, spec):\n",
    "        \"\"\"Apply SpecAugment\"\"\"\n",
    "        freq_mask = torchaudio.transforms.FrequencyMasking(CONFIG['freq_mask_param'])\n",
    "        time_mask = torchaudio.transforms.TimeMasking(CONFIG['time_mask_param'])\n",
    "        spec = freq_mask(spec)\n",
    "        spec = time_mask(spec)\n",
    "        return spec\n",
    "    \n",
    "    def _encode_text(self, text):\n",
    "        \"\"\"Convert text to indices\"\"\"\n",
    "        return torch.tensor([self.char_to_idx.get(c, 0) for c in text])\n",
    "    \n",
    "    def __len__(self):\n",
    "        return self.total_samples\n",
    "\n",
    "def collate_fn(batch):\n",
    "    \"\"\"Collate function for variable length sequences\"\"\"\n",
    "    features = [item['features'] for item in batch]\n",
    "    labels = [item['labels'] for item in batch]\n",
    "    texts = [item['text'] for item in batch]\n",
    "    \n",
    "    # Pad features\n",
    "    feature_lengths = torch.tensor([f.shape[0] for f in features])\n",
    "    features_padded = nn.utils.rnn.pad_sequence(features, batch_first=True)\n",
    "    \n",
    "    # Pad labels\n",
    "    label_lengths = torch.tensor([len(l) for l in labels])\n",
    "    labels_padded = nn.utils.rnn.pad_sequence(labels, batch_first=True, padding_value=0)\n",
    "    \n",
    "    return {\n",
    "        'features': features_padded,\n",
    "        'feature_lengths': feature_lengths,\n",
    "        'labels': labels_padded,\n",
    "        'label_lengths': label_lengths,\n",
    "        'texts': texts\n",
    "    }\n",
    "\n",
    "print(\"Streaming dataset class defined\")"
   ]
  },
