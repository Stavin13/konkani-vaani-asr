   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Load Checkpoint Function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_best_model_checkpoint(device='cuda'):\n",
    "    \"\"\"\n",
    "    Load the specific best_model (1).pt checkpoint for training\n",
    "    \n",
    "    This function is specifically designed for the checkpoint structure\n",
    "    found in /Volumes/data&proj/konkani/best_model (1).pt\n",
    "    \"\"\"\n",
    "    \n",
    "    # Kaggle paths - CHANGE THIS to your checkpoint dataset name\n",
    "    checkpoint_paths = [\n",
    "        \"/kaggle/input/konkanivani-checkpoint/best_model (1).pt\",  # Replace dataset name\n",
    "        \"/kaggle/input/konkanivani-checkpoint/best_model.pt\",      # Alternative name\n",
    "        \"/kaggle/working/best_model (1).pt\"\n",
    "    ]\n",
    "    \n",
    "    # Find checkpoint\n",
    "    checkpoint_path = None\n",
    "    for path in checkpoint_paths:\n",
    "        if os.path.exists(path):\n",
    "            checkpoint_path = path\n",
    "            break\n",
    "    \n",
    "    if checkpoint_path is None:\n",
    "        raise FileNotFoundError(f\"Checkpoint not found. Tried: {checkpoint_paths}\")\n",
    "    \n",
    "    print(f\"📂 Loading checkpoint: {checkpoint_path}\")\n",
    "    \n",
    "    # Load checkpoint\n",
    "    checkpoint = torch.load(checkpoint_path, map_location=device)\n",
    "    \n",
    "    print(f\"📊 Checkpoint keys: {list(checkpoint.keys())}\")\n",
    "    \n",
    "    # Get model state dict\n",
    "    model_state = checkpoint['model_state_dict']\n",
    "    \n",
    "    # Check for DataParallel wrapper and remove if present\n",
    "    has_module_prefix = any(key.startswith('module.') for key in model_state.keys())\n",
    "    if has_module_prefix:\n",
    "        print(\"🔧 Removing DataParallel 'module.' prefix...\")\n",
    "        model_state = {k.replace('module.', ''): v for k, v in model_state.items()}\n",
    "        checkpoint['model_state_dict'] = model_state\n",
    "    \n",
    "    # Extract model configuration\n",
    "    # Get vocab_size\n",
    "    vocab_size = checkpoint.get('vocab_size', None)\n",
    "    if vocab_size is None:\n",
    "        vocab_size = model_state['ctc_head.weight'].shape[0]\n",
    "    \n",
    "    # Get d_model from encoder input projection\n",
    "    d_model = model_state['encoder.input_proj.weight'].shape[0]\n",
    "    \n",
    "    # Count encoder layers\n",
    "    encoder_layers = 0\n",
    "    for key in model_state.keys():\n",
    "        if 'encoder.layers.' in key and '.ff1.0.weight' in key:\n",
    "            layer_num = int(key.split('.')[2])\n",
    "            encoder_layers = max(encoder_layers, layer_num + 1)\n",
    "    \n",
    "    # Count decoder layers\n",
    "    decoder_layers = 0\n",
    "    for key in model_state.keys():\n",
    "        if 'decoder.decoder.layers.' in key and '.linear1.weight' in key:\n",
    "            layer_num = int(key.split('.')[3])\n",
    "            decoder_layers = max(decoder_layers, layer_num + 1)\n",
    "    \n",
    "    print(f\"📐 Model architecture:\")\n",
    "    print(f\"  - vocab_size: {vocab_size}\")\n",
    "    print(f\"  - d_model: {d_model}\")\n",
    "    print(f\"  - encoder_layers: {encoder_layers}\")\n",
    "    print(f\"  - decoder_layers: {decoder_layers}\")\n",
    "    \n",
    "    # Extract training info\n",
    "    epoch = checkpoint.get('epoch', 0)\n",
    "    optimizer_state = checkpoint.get('optimizer_state_dict', None)\n",
    "    scheduler_state = checkpoint.get('scheduler_state_dict', None)\n",
    "    \n",
    "    print(f\"📈 Training info:\")\n",
    "    print(f\"  - Last epoch: {epoch}\")\n",
    "    print(f\"  - Has optimizer state: {optimizer_state is not None}\")\n",
    "    print(f\"  - Has scheduler state: {scheduler_state is not None}\")\n",
    "    \n",
    "    # Extract vocabulary if available\n",
    "    vocab_info = {}\n",
    "    if 'idx_to_char' in checkpoint and 'char_to_idx' in checkpoint:\n",
    "        vocab_info['idx_to_char'] = checkpoint['idx_to_char']\n",
    "        vocab_info['char_to_idx'] = checkpoint['char_to_idx']\n",
    "        print(f\"📚 Vocabulary loaded from checkpoint: {len(vocab_info['char_to_idx'])} chars\")\n",
    "    else:\n",
    "        print(\"⚠️  No vocabulary in checkpoint - you'll need to load it separately\")\n",
    "    \n",
    "    return {\n",
    "        'model_state_dict': model_state,\n",
    "        'optimizer_state_dict': optimizer_state,\n",
    "        'scheduler_state_dict': scheduler_state,\n",
    "        'epoch': epoch,\n",
    "        'vocab_size': vocab_size,\n",
    "        'd_model': d_model,\n",
    "        'encoder_layers': encoder_layers,\n",
    "        'decoder_layers': decoder_layers,\n",
    "        'vocab_info': vocab_info,\n",
    "        'checkpoint': checkpoint\n",
    "    }"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Load Checkpoint and Create Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load checkpoint info\n",
    "checkpoint_info = load_best_model_checkpoint(device)\n",
    "\n",
    "# Create model with correct configuration\n",
    "model = KonkaniVaniASR(\n",
    "    vocab_size=checkpoint_info['vocab_size'],\n",
    "    input_dim=80,  # Mel spectrogram features\n",
    "    d_model=checkpoint_info['d_model'],\n",
    "    encoder_layers=checkpoint_info['encoder_layers'],\n",
    "    decoder_layers=checkpoint_info['decoder_layers']\n",
    ")\n",
    "\n",
    "# Load model weights\n",
    "model.load_state_dict(checkpoint_info['model_state_dict'])\n",
    "model.to(device)\n",
    "\n",
    "# CRITICAL: Set to training mode\n",
    "model.train()\n",
    "\n",
    "print(f\"✅ Model loaded and set to training mode!\")\n",
    "print(f\"📊 Model parameters: {sum(p.numel() for p in model.parameters()):,}\")\n",
    "print(f\"📊 Trainable parameters: {sum(p.numel() for p in model.parameters() if p.requires_grad):,}\")\n",
    "print(f\"🎯 Training mode: {model.training}\")\n",
    "print(f\"🎯 Requires grad: {next(model.parameters()).requires_grad}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Setup Optimizer and Scheduler"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create optimizer - using lower learning rate for fine-tuning\n",
    "optimizer = optim.AdamW(\n",
    "    model.parameters(),\n",
    "    lr=5e-5,  # Lower LR for fine-tuning from checkpoint\n",
    "    weight_decay=0.01,\n",
    "    betas=(0.9, 0.999)\n",
    ")\n",
    "\n",
    "# Load previous optimizer state if available\n",
    "if checkpoint_info['optimizer_state_dict'] is not None:\n",
    "    try:\n",
    "        optimizer.load_state_dict(checkpoint_info['optimizer_state_dict'])\n",
    "        print(\"✅ Loaded optimizer state from checkpoint\")\n",
    "        \n",
    "        # Optionally adjust learning rate\n",
    "        for param_group in optimizer.param_groups:\n",
    "            param_group['lr'] = 5e-5  # Override with new LR\n",
    "        print(f\"🔧 Adjusted learning rate to: {5e-5}\")\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ Could not load optimizer state: {e}\")\n",
    "        print(\"🔄 Using fresh optimizer\")\n",
    "else:\n",
    "    print(\"🔄 No optimizer state in checkpoint - using fresh optimizer\")\n",
    "\n",
    "# Create scheduler\n",
    "scheduler = optim.lr_scheduler.ReduceLROnPlateau(\n",
    "    optimizer,\n",
    "    mode='min',\n",
    "    factor=0.5,\n",
    "    patience=3,\n",
    "    verbose=True,\n",
    "    min_lr=1e-6\n",
    ")\n",
    "\n",
    "# Load previous scheduler state if available\n",
    "if checkpoint_info['scheduler_state_dict'] is not None:\n",
    "    try:\n",
    "        scheduler.load_state_dict(checkpoint_info['scheduler_state_dict'])\n",
    "        print(\"✅ Loaded scheduler state from checkpoint\")\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ Could not load scheduler state: {e}\")\n",
    "        print(\"🔄 Using fresh scheduler\")\n",
    "else:\n",
    "    print(\"🔄 No scheduler state in checkpoint - using fresh scheduler\")\n",
    "\n",
    "# Setup loss function\n",
    "criterion = nn.CTCLoss(blank=0, reduction='mean', zero_infinity=True)\n",
    "\n",
    "# Training configuration\n",
    "start_epoch = checkpoint_info['epoch'] + 1\n",
    "print(f\"\\n📈 Will resume training from epoch: {start_epoch}\")\n",
    "print(f\"📊 Current learning rate: {optimizer.param_groups[0]['lr']}\")"
   ]
  },
